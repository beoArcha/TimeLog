{
  "name": "timelog",
  "private": true,
  "version": "1.14.4",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --base=/TimeLog/app/ && bun scripts/verify-pwa-paths.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "fmt:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "fmt:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit/",
    "test:arch:ast": "vitest run tests/architecture/specs/",
    "test:smoke": "vitest run tests/smoke/; cargo test --manifest-path src-tauri/Cargo.toml --test smoke_test",
    "test:arch:rust": "cargo test --manifest-path src-tauri/Cargo.toml --test architecture_tests",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:e2e:print": "playwright test tests/e2e/specs/reports-print.spec.ts --config=tests/e2e/config/playwright.config.ts",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:mutation": "stryker run",
    "test:quality": "bun run test:smoke; bun run test:arch:rust; bun run check; bun run test:rust; bun run test",
    "check": "bun run typecheck; bun run lint; bun run lint:rust; bun run fmt:rust:check",
    "docs:validate": "bun scripts/validate-docs.js",
    "docs:serve": "bunx serve docs/wiki",
    "metadata:sync": "bun scripts/sync_metadata.js",
    "metadata:check": "bun scripts/sync_metadata.js --check",
    "graphify:build": "graphify . --code-only --directed",
    "graphify:update": "graphify . --code-only --update --directed",
    "graphify:watch": "graphify . --code-only --watch --directed",
    "graphify:report": "bun -e \"console.log(require('fs').readFileSync('graphify-out/GRAPH_REPORT.md', 'utf-8'))\"",
    "graphify:viz": "bun -e \"import('open').then(m => m.default('graphify-out/graph.html'))\"",
    "graphify:diagnose": "graphify diagnose"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.13.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^2.0.0",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  },
  "author": "Marcin 'beoArcha' Stefan",
  "description": "Lightweight, local-first work timer and task tracker built with Rust, Tauri v2, SQLite, and React 19."
}
