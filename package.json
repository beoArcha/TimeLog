{
  "name": "oxy-flow",
  "private": true,
  "version": "1.6.11",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "typecheck:rust": "cargo check --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "lint:rust:fix": "cargo clippy --manifest-path src-tauri/Cargo.toml --fix --allow-dirty --allow-staged",
    "format:rust": "cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:rust:check": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "test": "vitest run",
    "test:arch": "vitest run tests/architecture/specs",
    "test:arch:all": "vitest run tests/architecture",
    "test:e2e": "playwright test --config=tests/e2e/config/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=tests/e2e/config/playwright.config.ts --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:coverage": "cargo tarpaulin --manifest-path src-tauri/Cargo.toml",
    "build:tauri": "npx @tauri-apps/cli build",
    "build:tauri:debug": "npx @tauri-apps/cli build --debug",
    "build:all": "npm run build && npm run build:tauri",
    "build:all:debug": "npm run build:tauri:debug",
    "fix:all": "npm run lint:fix && npm run format:rust",
    "check:all": "npm run typecheck && npm run typecheck:rust && npm run format:rust:check && npm run lint && npm run lint:rust",
    "test:all": "npm run test && npm run test:rust",
    "check:frontend": "npm run typecheck && npm run lint && npm run test:arch && npm run test",
    "check:backend": "npm run typecheck:rust && npm run format:rust:check && npm run lint:rust"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@google/genai": "^2.30.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.43.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.25.12",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "nyc": "^18.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.12"
  }
}
