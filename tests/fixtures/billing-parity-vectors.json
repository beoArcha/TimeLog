      "expectedCents": 15000,
      "valid": true
    },
    {
      "description": "Valid single decimal place",
      "input": "150.5",
      "expectedCents": 15050,
      "valid": true
    },
    {
      "description": "Valid integer rate",
      "input": "150",
      "expectedCents": 15000,
      "valid": true
    },
    {
      "description": "Valid zero rate",
      "input": "0.00",
      "expectedCents": 0,
      "valid": true
    },
    {
      "description": "Valid integer zero rate",
      "input": "0",
      "expectedCents": 0,
      "valid": true
    },
    {
      "description": "Valid rate with trailing dot",
      "input": "150.",
      "expectedCents": 15000,
      "valid": true
    },
    {
      "description": "Valid rate with surrounding whitespace",
