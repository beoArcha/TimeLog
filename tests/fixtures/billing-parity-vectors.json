      "valid": false
    },
    {
      "description": "Reject negative rate",
      "input": "-50.00",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject non-numeric string",
      "input": "abc",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject missing whole component (leading dot)",
      "input": ".5",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject scientific notation",
      "input": "1e2",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject hexadecimal notation",
      "input": "0x10",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject negative zero",
      "input": "-0",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject negative zero decimal",
      "input": "-0.00",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject explicit positive sign",
      "input": "+150.00",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject empty string",
      "input": "",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Reject whitespace only",
      "input": "   ",
      "expectedCents": null,
      "valid": false
    },
    {
      "description": "Supported boundary integer rate",
      "input": "90071992547409",
      "expectedCents": 9007199254740900,
      "valid": true
    },
    {
      "description": "Reject rate beyond supported integer boundary",
      "input": "999999999999999999999999999999999999",
      "expectedCents": null,
      "valid": false
    }
  ],
