      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "Europe/Warsaw",
      "expected": {
        "from": "2026-11-02T07:15:00Z",
        "to": "2026-11-02T16:45:30Z",
        "timezone": "Europe/Warsaw"
      }
    },
    {
      "description": "custom offset bounds are used as-is",
