    {
      "description": "leap second in an RFC3339 bound is rejected",
      "request": {
        "from": "2026-03-05T23:59:60Z"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "UTC",
      "expectedErrorCode": "DOM_INVALID_RANGE_INPUT"
    },
    {
      "description": "leap second with an offset is rejected",
      "request": {
        "to": "2026-03-06T00:59:60+01:00"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "UTC",
      "expectedErrorCode": "DOM_INVALID_RANGE_INPUT"
    },
    {
      "description": "leap second in a naive bound is rejected",
      "request": {
        "from": "2026-03-05T23:59:60"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "UTC",
      "expectedErrorCode": "DOM_INVALID_RANGE_INPUT"
    },
    {
      "description": "leap second in a space-separated naive bound is rejected",
      "request": {
        "from": "2026-03-05 23:59:60"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "UTC",
      "expectedErrorCode": "DOM_INVALID_RANGE_INPUT"
    },
    {
      "description": "bounds equal after sub-second truncation are rejected",
      "request": {
        "from": "2026-03-05T10:00:00.500Z",
        "to": "2026-03-05T10:00:00.900Z"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "UTC",
      "expectedErrorCode": "DOM_INVALID_RANGE_INPUT"
    },
    {
      "description": "timezone name in the wrong letter case is rejected",
      "request": {
        "preset": "today"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "europe/warsaw",
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "unknown timezone name is rejected",
      "request": {
        "preset": "today"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "Mars/Olympus",
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "numeric offset is not a timezone name",
      "request": {
        "preset": "today"
      },
      "now": "2026-11-11T21:30:00Z",
      "timeZone": "+01:00",
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    }
  ],
  "timezoneVectors": [
    {
      "description": "explicit wins over setting",
      "explicit": "America/New_York",
      "setting": "Europe/Warsaw",
      "expected": "America/New_York"
    },
    {
      "description": "setting is used when explicit is absent",
      "explicit": null,
      "setting": "Europe/Warsaw",
      "expected": "Europe/Warsaw"
    },
    {
      "description": "blank explicit falls back to the setting",
      "explicit": "  ",
      "setting": "Asia/Tokyo",
      "expected": "Asia/Tokyo"
    },
    {
      "description": "valid name is echoed back trimmed",
      "explicit": "  Europe/Warsaw ",
      "setting": null,
      "expected": "Europe/Warsaw"
    },
    {
      "description": "UTC is a valid name",
      "explicit": "UTC",
      "setting": null,
      "expected": "UTC"
    },
    {
      "description": "link name keeps the spelling it was given",
      "explicit": "US/Eastern",
      "setting": null,
      "expected": "US/Eastern"
    },
    {
      "description": "Etc/UTC keeps the spelling it was given",
      "explicit": "Etc/UTC",
      "setting": null,
      "expected": "Etc/UTC"
    },
    {
      "description": "invalid explicit is not rescued by a valid setting",
      "explicit": "Mars/Olympus",
      "setting": "Europe/Warsaw",
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "invalid setting is rejected when explicit is absent",
      "explicit": null,
      "setting": "Mars/Olympus",
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "lowercase variant of a canonical name is rejected",
      "explicit": "europe/warsaw",
      "setting": null,
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "uppercase variant of a canonical name is rejected",
      "explicit": "EUROPE/WARSAW",
      "setting": null,
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "lowercase UTC is rejected",
      "explicit": "utc",
      "setting": null,
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "lowercase link name is rejected",
      "explicit": "us/eastern",
      "setting": null,
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    },
    {
      "description": "numeric offset is rejected",
      "explicit": "+01:00",
      "setting": null,
      "expectedErrorCode": "DOM_INVALID_TIMEZONE"
    }
  ]
