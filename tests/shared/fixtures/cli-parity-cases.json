[
  {
    "id": "status-idle",
    "description": "Status query when no active timers are running",
    "commandFrontend": "status",
    "commandRust": ["status"],
    "initialActiveTaskId": null,
    "expectSuccess": true,
    "expectedPatterns": ["status", "idle", "0", "no active", "stopped"]
  },
  {
    "id": "status-active",
    "description": "Status query with an active running task",
    "commandFrontend": "status",
    "commandRust": ["status"],
    "initialActiveTaskId": "t1",
    "expectSuccess": true,
    "expectedPatterns": ["status", "t1", "parity task", "1"]
  },
  {
    "id": "start-valid",
    "description": "Start timer on valid existing task",
    "commandFrontend": "start t1",
    "commandRust": ["start", "t1"],
    "initialActiveTaskId": null,
    "expectSuccess": true,
    "expectedPatterns": ["start", "t1"]
  },
  {
    "id": "stop-active",
    "description": "Stop active running timer",
    "commandFrontend": "stop",
    "commandRust": ["stop"],
    "initialActiveTaskId": "t1",
    "expectSuccess": true,
    "expectedPatterns": ["stop"]
  },
  {
    "id": "switch-valid",
    "description": "Switch active timer to task",
    "commandFrontend": "switch t1",
    "commandRust": ["switch", "t1"],
    "initialActiveTaskId": null,
    "expectSuccess": true,
    "expectedPatterns": ["t1"]
  },
  {
    "id": "unknown-command",
    "description": "Syntax rejection on unknown command",
    "commandFrontend": "unrecognized_command_xyz",
    "commandRust": ["unrecognized_command_xyz"],
    "initialActiveTaskId": null,
    "expectSuccess": false,
    "expectedPatterns": ["error", "unknown", "unrecognized"]
  },
  {
    "id": "start-not-found",
    "description": "Start timer on non-existent task fails across runtimes",
    "commandFrontend": "start non-existent-id-999",
    "commandRust": ["start", "non-existent-id-999"],
    "initialActiveTaskId": null,
    "expectSuccess": false,
    "expectedPatterns": ["error", "not exist", "not found"]
  }
]
